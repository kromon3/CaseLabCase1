# Базовые URL внешнего REST API (Open-Meteo, ключ доступа не требуется)
GEOCODING_API_URL=https://geocoding-api.open-meteo.com/v1/search
FORECAST_API_URL=https://api.open-meteo.com/v1/forecast

# Таймаут одного HTTP-запроса в миллисекундах (AbortController)
REQUEST_TIMEOUT_MS=5000

# Каталог для сохранения отчётов
REPORTS_DIR=reports

# Число дней прогноза по умолчанию (допустимый диапазон 1..7)
DEFAULT_FORECAST_DAYS=3

# Единицы измерения: celsius | fahrenheit, mm | inch
TEMPERATURE_UNIT=celsius
PRECIPITATION_UNIT=mm

# Язык ответа геокодинга и часовой пояс прогноза
GEOCODING_LANGUAGE=ru
FORECAST_TIMEZONE=auto

# Города по умолчанию, если --city не передан (удобно для Docker): CITY=Казань,Самара
# CITY=
