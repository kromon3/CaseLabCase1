    {
      "name": "2. Forecast — прогноз по координатам",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 200', () => pm.response.to.have.status(200));",
              "pm.test('Ответ — JSON', () => pm.response.to.be.json);",
              "",
              "const body = pm.response.json();",
              "pm.test('Есть блок daily с нужными колонками', () => {",
              "  pm.expect(body).to.have.property('daily');",
              "  pm.expect(body.daily.time).to.be.an('array');",
              "  pm.expect(body.daily.temperature_2m_max).to.be.an('array');",
              "  pm.expect(body.daily.temperature_2m_min).to.be.an('array');",
              "  pm.expect(body.daily.precipitation_sum).to.be.an('array');",
              "});",
              "pm.test('Число дней совпадает с forecast_days', () => {",
              "  const days = Number(pm.collectionVariables.get('days'));",
              "  pm.expect(body.daily.time.length).to.eql(days);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{forecastBaseUrl}}/v1/forecast?latitude={{lat}}&longitude={{lon}}&daily=temperature_2m_max,temperature_2m_min,precipitation_sum&forecast_days={{days}}&timezone=auto",
          "host": [
            "{{forecastBaseUrl}}"
          ],
          "path": [
            "v1",
            "forecast"
          ],
          "query": [
            {
              "key": "latitude",
              "value": "{{lat}}",
              "description": "Широта из ответа геокодинга (results[0].latitude)"
            },
            {
              "key": "longitude",
              "value": "{{lon}}",
              "description": "Долгота из ответа геокодинга (results[0].longitude)"
            },
            {
              "key": "daily",
              "value": "temperature_2m_max,temperature_2m_min,precipitation_sum"
            },
            {
              "key": "forecast_days",
              "value": "{{days}}",
              "description": "Число дней прогноза, утилита допускает 1..7"
            },
            {
              "key": "timezone",
              "value": "auto"
            }
          ]
        },
        "description": "Второй запрос цепочки: координаты -> прогноз по дням. lat/lon подставляются из переменных, которые заполняет тест запроса Geocoding."
      },
