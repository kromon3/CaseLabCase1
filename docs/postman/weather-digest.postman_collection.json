{
  "info": {
    "_postman_id": "3f9c0c62-6d5e-4f2a-9d1c-5b7e2a1c9f10",
    "name": "Weather Digest — Open-Meteo",
    "description": "Коллекция к консольной утилите «Погодный дайджест». Два связанных запроса: 1) геокодинг по названию города, 2) прогноз по полученным координатам. Значения вынесены в переменные коллекции: {{geocodingBaseUrl}}, {{forecastBaseUrl}}, {{city}}, {{lat}}, {{lon}}, {{days}}. Тест запроса Geocoding автоматически записывает lat/lon в переменные коллекции, поэтому запросы удобно запускать по порядку через Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Geocoding — координаты по названию города",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 200', () => pm.response.to.have.status(200));",
              "pm.test('Ответ — JSON', () => pm.response.to.be.json);",
              "",
              "const body = pm.response.json();",
              "if (Array.isArray(body.results) && body.results.length > 0) {",
              "  const place = body.results[0];",
              "  pm.test('Есть координаты', () => {",
              "    pm.expect(place.latitude).to.be.a('number');",
              "    pm.expect(place.longitude).to.be.a('number');",
              "  });",
              "  // Передаём координаты во второй запрос цепочки",
              "  pm.collectionVariables.set('lat', String(place.latitude));",
              "  pm.collectionVariables.set('lon', String(place.longitude));",
              "  console.log(`Найдено: ${place.name}, ${place.country} (${place.latitude}, ${place.longitude})`);",
              "} else {",
              "  console.warn('Город не найден: в ответе нет поля results');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{geocodingBaseUrl}}/v1/search?name={{city}}&count=1&language=ru&format=json",
          "host": [
            "{{geocodingBaseUrl}}"
          ],
          "path": [
            "v1",
            "search"
          ],
          "query": [
            {
              "key": "name",
              "value": "{{city}}",
              "description": "Название города (кириллица допустима, кодируется автоматически)"
            },
            {
              "key": "count",
              "value": "1",
              "description": "Сколько совпадений вернуть"
            },
            {
              "key": "language",
              "value": "ru",
              "description": "Язык названий в ответе"
            },
            {
              "key": "format",
              "value": "json"
            }
          ]
        },
        "description": "Первый запрос цепочки: название города -> координаты. Если город не найден, API отвечает 200 без поля results."
      },
